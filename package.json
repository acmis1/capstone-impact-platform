{
  "name": "capstone-impact-platform",
  "private": true,
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.11.0 <12"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "onboarding:check": "npm run check:onboarding --workspace=apps/admin-cms",
    "dev:admin": "npm run dev --workspace=apps/admin-cms",
    "build:admin": "npm run build --workspace=apps/admin-cms",
    "typecheck:admin": "npm run typecheck --workspace=apps/admin-cms",
    "check:feed": "npm run check:sample-feed --workspace=apps/admin-cms",
    "benchmark:projects": "npm run benchmark:projects --workspace=apps/admin-cms --",
    "seed:admin-staging": "npm run seed:staging --workspace=apps/admin-cms --",
    "check:admin-staging": "npm run check:staging-projects --workspace=apps/admin-cms",
    "seed:admin-media": "npm run seed:staging-media --workspace=apps/admin-cms --",
    "check:admin-media": "npm run check:staging-media --workspace=apps/admin-cms",
    "publish:admin-feed": "npm run publish:staging-feed --workspace=apps/admin-cms --",
    "import:admin-package": "npm run import:staging-package --workspace=apps/admin-cms --",
    "check:admin-imports": "npm run check:import-batches --workspace=apps/admin-cms",
    "test:admin": "npm run test:run --workspace=apps/admin-cms",
    "check:admin-auth": "npm run check:staging-auth --workspace=apps/admin-cms",
    "link:admin-staging": "npm run link:staging-admin --workspace=apps/admin-cms --",
    "supabase:start": "tsx apps/admin-cms/src/scripts/runLocalSupabase.ts start",
    "supabase:stop": "tsx apps/admin-cms/src/scripts/runLocalSupabase.ts stop",
    "supabase:reset": "tsx apps/admin-cms/src/scripts/runLocalSupabase.ts reset",
    "supabase:seed:buckets": "npm run seed:buckets:local --workspace=apps/admin-cms --",
    "supabase:env:local": "npm run env:local --workspace=apps/admin-cms --",
    "supabase:users:local": "npm run users:local --workspace=apps/admin-cms --",
    "supabase:verify:local": "npm run verify:local --workspace=apps/admin-cms --",
    "setup:local": "npm run setup:local --workspace=apps/admin-cms",
    "verify:all": "npm run verify:all --workspace=apps/admin-cms",
    "check:onboarding-docs": "npm run check:onboarding-docs --workspace=apps/admin-cms",
    "verify:onboarding-workflow": "npm run verify:onboarding-workflow --workspace=apps/admin-cms",
    "check:app-smoke": "npm run check:app-smoke --workspace=apps/admin-cms",
    "check:diff": "npm run check:diff --workspace=apps/admin-cms",
    "check:terminology": "tsx apps/admin-cms/src/scripts/repositoryChecks.ts terminology",
    "check:yaml": "tsx apps/admin-cms/src/scripts/repositoryChecks.ts yaml",
    "check:markdown-links": "tsx apps/admin-cms/src/scripts/repositoryChecks.ts markdown-links",
    "supabase:assert-running": "tsx apps/admin-cms/src/scripts/assertSupabaseRunning.ts",
    "supabase:assert-stopped": "tsx apps/admin-cms/src/scripts/assertSupabaseStopped.ts",
    "verify:browser-metadata-stage-runtime": "npm run verify:browser-metadata-stage-runtime --workspace=apps/admin-cms",
    "verify:review-actions-runtime": "npm run verify:review-actions-runtime --workspace=apps/admin-cms",
    "verify:browser-media-stage-runtime": "npm run verify:browser-media-stage-runtime --workspace=apps/admin-cms",
    "verify:import-batch-review-submit-runtime": "npm run verify:import-batch-review-submit-runtime --workspace=apps/admin-cms",
    "verify:participant-preview-runtime": "npm run verify:participant-preview-runtime --workspace=apps/admin-cms",
    "verify:controlled-publication-runtime": "npm run verify:controlled-publication-runtime --workspace=apps/admin-cms",
    "verify:controlled-public-removal-runtime": "npm run verify:controlled-public-removal-runtime --workspace=apps/admin-cms"
  },
  "devDependencies": {
    "server-only": "^0.0.1",
    "supabase": "2.109.1"
  }
}
