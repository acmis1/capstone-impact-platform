# Supabase connection URL for the synthetic staging project.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe client keys. The modern publishable key is preferred; the legacy
# anon key remains supported as a fallback. Never put a server credential here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only private database admin keys. Configure one through the approved
# secret store; the modern secret key is preferred over the legacy fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Independent server-only secret for short-lived password-recovery context cookies.
CAPSTONE_AUTH_FLOW_SECRET=

# Shared staging runtime identity. The expected host is the target Supabase
# hostname only, without scheme, path, port or trailing dot.
CAPSTONE_RUNTIME_ENV=staging
CAPSTONE_EXPECTED_SUPABASE_HOST=
# CAPSTONE_EXPECTED_SUPABASE_PROJECT_REF belongs only to the dedicated participant
# reminder runner profile and is intentionally not a web-service assignment here.
CAPSTONE_STAGING_MUTATION_CONFIRMATION=

# Staging publication and historical rollback are separate exact-true controls.
# Keep them disabled in this example; neither flag authorizes a production target.
CAPSTONE_STAGING_PUBLICATION_ENABLED=false
CAPSTONE_STAGING_PUBLIC_FEED_ROLLBACK_ENABLED=false

# Production controls are shown only as disabled safety defaults. Production
# capability activation still requires its own verified identity, qualified
# process and institutional authorization.
CAPSTONE_PRODUCTION_PUBLICATION_ENABLED=false
CAPSTONE_PRODUCTION_ASSISTIVE_ENABLED=false
# This reminder capability is shown as a disabled safety sentinel; it is
# consumed only by the dedicated production reminder runner, not staging web.
CAPSTONE_PRODUCTION_REMINDERS_ENABLED=false
# CAPSTONE_PRODUCTION_REMINDERS_ACKNOWLEDGEMENT=

# Staging storage defaults.
SUPABASE_DRAFT_BUCKET=project-drafts-private
SUPABASE_PUBLIC_ASSETS_BUCKET=project-public-assets
SUPABASE_PUBLIC_FEEDS_BUCKET=public-feeds
SUPABASE_PUBLIC_FEED_FILE=capstones-latest.json

# Optional assistive extraction adapter. It remains disabled unless separately
# configured and approved; the API key is always blank in this example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ASSISTIVE_EXTRACTION_ENABLED=false

# Optional web-side capabilities. Each remains disabled until its own target,
# provider, acceptance and authorization requirements are complete.
PARTICIPANT_PREVIEW_EMAIL_ENABLED=false
PARTICIPANT_PREVIEW_REMINDERS_ENABLED=false
STAFF_PROVISIONING_ENABLED=false
CAPSTONE_ASSISTIVE_HOSTED_EXECUTION_ENABLED=false

# Temporary maintenance is a deny control and is disabled by default.
CAPSTONE_STAGING_MAINTENANCE_MODE=false

# Participant preview SMTP settings are server-only and blank keeps delivery
# unavailable. Use an institution-approved provider and sender when authorized.
PARTICIPANT_PREVIEW_EMAIL_SMTP_HOST=
PARTICIPANT_PREVIEW_EMAIL_SMTP_PORT=
PARTICIPANT_PREVIEW_EMAIL_SMTP_SECURE=
PARTICIPANT_PREVIEW_EMAIL_SMTP_USER=
PARTICIPANT_PREVIEW_EMAIL_SMTP_PASSWORD=
PARTICIPANT_PREVIEW_EMAIL_FROM=

# Web-side compatibility expectations for a separately qualified assistive
# worker. These values do not prove a deployment or replace a fresh heartbeat.
CAPSTONE_ASSISTIVE_EXPECTED_WORKER_DEPLOYMENT_VERSION=
CAPSTONE_ASSISTIVE_EXPECTED_WORKER_IMAGE_DIGEST=

# Render injects RENDER, RENDER_GIT_COMMIT and RENDER_EXTERNAL_URL. Do not add
# assignments for those provider identities or use this file to imitate Render.
# A provider-neutral worker/dispatcher uses CAPSTONE_DEPLOYMENT_VERSION in its
# own process profile; it is not a staging-manifest owner value.
