# Supabase Connection URL (Staging project)
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe client keys
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is preferred over legacy NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Every populated NEXT_PUBLIC key is validated independently before a production build: use
# sb_publishable_* with a non-empty suffix or a legacy JWT whose payload role is exactly anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only private database admin keys
# SUPABASE_SECRET_KEY is the modern server-only secret key format, while SUPABASE_SERVICE_ROLE_KEY is the legacy JWT format.
# SUPABASE_SECRET_KEY is preferred for server administration, falling back to SUPABASE_SERVICE_ROLE_KEY for temporary compatibility.
# The selected value must be sb_secret_* with a non-empty suffix or a legacy JWT whose payload role is exactly service_role.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated server-only key for signing short-lived password-recovery context cookies.
# Configure at least 32 random bytes. Never reuse a Supabase, database, SMTP, or provider secret.
CAPSTONE_AUTH_FLOW_SECRET=

# Shared Staging Runtime Guard Configuration
# Private deployment configuration for shared staging target identity verification.
# Expected host must match the target Supabase hostname (e.g. app-staging.supabase.co) without scheme or path.
# CAPSTONE_STAGING_MUTATION_CONFIRMATION is required only for authorized mutating staging commands (e.g. capstone-admin-cms-staging-v2-2026).
# It is a non-secret human acknowledgement label, environment-specific, independent from hostname identity, with no default.
# These variables do NOT replace Supabase credentials and must NEVER contain secrets or be committed.
CAPSTONE_RUNTIME_ENV=
CAPSTONE_EXPECTED_SUPABASE_HOST=
CAPSTONE_STAGING_MUTATION_CONFIRMATION=

# Staging Storage Buckets
SUPABASE_DRAFT_BUCKET=project-drafts-private
SUPABASE_PUBLIC_ASSETS_BUCKET=project-public-assets
SUPABASE_PUBLIC_FEEDS_BUCKET=public-feeds
SUPABASE_PUBLIC_FEED_FILE=capstones-latest.json

# Gemini AI Extraction (Staging Assistive Tools)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ASSISTIVE_EXTRACTION_ENABLED=false
