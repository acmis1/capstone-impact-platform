FROM node:24.21.0-bookworm-slim AS coordinator-build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/admin-cms/package.json apps/admin-cms/package.json

RUN npm ci --ignore-scripts

COPY apps/admin-cms apps/admin-cms
COPY apps/assistive-worker/tests/fixtures/phase-2-consumer-native-pdf.json apps/assistive-worker/tests/fixtures/phase-2-consumer-native-pdf.json

RUN npm run build:assistive-worker --workspace=apps/admin-cms

FROM node:24.21.0-bookworm-slim AS provider-build

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/capstone/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl gcc libc6-dev libgl1 libglib2.0-0 libgomp1 python3 python3-pip python3-venv tar unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/assistive-worker apps/assistive-worker

RUN mkdir -p /opt/capstone/bin \
    && cc -std=c17 -O2 -Wall -Wextra -Werror \
      apps/assistive-worker/credential_boundary.c \
      -o /opt/capstone/bin/capstone-credential-boundary \
    && cc -std=c17 -O2 -Wall -Wextra -Werror -fPIC -shared \
      -DCAPSTONE_CREDENTIAL_BOUNDARY_PRELOAD \
      apps/assistive-worker/credential_boundary.c \
      -o /opt/capstone/bin/libcapstone-credential-boundary.so \
    && python3 -m venv /opt/capstone/venv \
    && curl --fail --location --silent --show-error \
      https://files.pythonhosted.org/packages/b0/e0/8f5d065ebb2e5941d289c5f653f944318f9e418bc5167bc6a346ab5e0f6a/opencv_contrib_python-4.10.0.84-cp37-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
      --output /tmp/opencv_contrib_python-4.10.0.84-cp37-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
    && echo 'a261223db41f6e512d76deaf21c8fcfb4fbbcbc2de62ca7f74a05f2c9ee489ef  /tmp/opencv_contrib_python-4.10.0.84-cp37-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl' | sha256sum --check --strict \
    && pip install --no-cache-dir --no-deps /tmp/opencv_contrib_python-4.10.0.84-cp37-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
    && rm -f /tmp/opencv_contrib_python-4.10.0.84-cp37-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64.whl \
    && pip install --no-cache-dir './apps/assistive-worker[paddle-title]'

RUN mkdir -p /opt/capstone/artifacts/paddle /opt/capstone/artifacts/languagetool \
    && curl --fail --location --silent --show-error \
      https://paddle-model-ecology.bj.bcebos.com/paddlex/official_inference_model/paddle3.0.0/PP-OCRv6_small_det_infer.tar \
      --output /tmp/PP-OCRv6_small_det_infer.tar \
    && echo 'bfb7c1e59f0faa6b540ebdca93aea3f4b1f2477805b389fbee117820d68fe9f5  /tmp/PP-OCRv6_small_det_infer.tar' | sha256sum --check --strict \
    && tar -xf /tmp/PP-OCRv6_small_det_infer.tar -C /opt/capstone/artifacts/paddle \
    && curl --fail --location --silent --show-error \
      https://paddle-model-ecology.bj.bcebos.com/paddlex/official_inference_model/paddle3.0.0/PP-OCRv6_small_rec_infer.tar \
      --output /tmp/PP-OCRv6_small_rec_infer.tar \
    && echo 'da460f968ce9f88325ac3a34fa302077d6e9b0dcefb16ba3137cd7796f879d06  /tmp/PP-OCRv6_small_rec_infer.tar' | sha256sum --check --strict \
    && tar -xf /tmp/PP-OCRv6_small_rec_infer.tar -C /opt/capstone/artifacts/paddle \
    && curl --fail --location --silent --show-error \
      https://languagetool.org/download/LanguageTool-6.6.zip \
      --output /opt/capstone/artifacts/languagetool/LanguageTool-stable.zip \
    && echo '53600506b399bb5ffe1e4c8dec794fd378212f14aaf38ccef9b6f89314d11631  /opt/capstone/artifacts/languagetool/LanguageTool-stable.zip' | sha256sum --check --strict \
    && unzip -q /opt/capstone/artifacts/languagetool/LanguageTool-stable.zip -d /opt/capstone/artifacts/languagetool \
    && echo 'f5279d946d901c90c0bb09cddaa6fdea8b26db9c548145d09041e8d1ac2d2b45  /opt/capstone/artifacts/languagetool/LanguageTool-6.6/languagetool-server.jar' | sha256sum --check --strict \
    && rm -f /tmp/PP-OCRv6_small_det_infer.tar /tmp/PP-OCRv6_small_rec_infer.tar

RUN python3 -c "import paddle; import paddleocr; import paddlex; from capstone_assistive_worker.ocr.contract import OcrAvailabilityState; from capstone_assistive_worker.ocr.paddle_title import PaddleTitleOcrProvider; availability = PaddleTitleOcrProvider(models_dir='/opt/capstone/artifacts/paddle').availability(); assert availability.state is OcrAvailabilityState.AVAILABLE, availability.message"

FROM node:24.21.0-bookworm-slim

ARG CAPSTONE_DEPLOYMENT_VERSION=""

LABEL org.opencontainers.image.revision="${CAPSTONE_DEPLOYMENT_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp/capstone-home \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PATH=/opt/capstone/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CACHE_HOME=/tmp/capstone-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates libgl1 libglib2.0-0 libgomp1 openjdk-17-jre-headless python3 tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=provider-build /opt/capstone/venv /opt/capstone/venv
COPY --from=provider-build /opt/capstone/artifacts /opt/capstone/artifacts
COPY --from=provider-build /opt/capstone/bin/capstone-credential-boundary /usr/local/bin/capstone-credential-boundary
COPY --from=provider-build /opt/capstone/bin/libcapstone-credential-boundary.so /usr/local/lib/libcapstone-credential-boundary.so
COPY --from=coordinator-build /app/apps/admin-cms/dist/assistive-worker.cjs /app/apps/admin-cms/src/scripts/assistive-worker.cjs
COPY --from=coordinator-build /app/apps/admin-cms/dist/assistive-worker-on-demand.cjs /app/apps/admin-cms/src/scripts/assistive-worker-on-demand.cjs

RUN mkdir -p /app/apps/assistive-worker

ENV LD_PRELOAD=/usr/local/lib/libcapstone-credential-boundary.so

USER node

RUN node --check apps/admin-cms/src/scripts/assistive-worker.cjs \
    && node --check apps/admin-cms/src/scripts/assistive-worker-on-demand.cjs \
    && capstone-credential-boundary --self-test \
    && capstone-credential-boundary node -e "const { spawnSync } = require('node:child_process'); const result = spawnSync('/bin/cat', ['/proc/' + process.pid + '/environ'], { stdio: 'ignore' }); process.exit(result.error || result.status === null ? 126 : result.status === 0 ? 1 : 0)"

ENTRYPOINT ["capstone-credential-boundary", "/usr/bin/tini", "--"]
CMD ["node", "apps/admin-cms/src/scripts/assistive-worker.cjs"]
